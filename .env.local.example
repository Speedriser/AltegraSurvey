# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (bot protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Domain restriction enforced at signup (e.g. altegra.com)
ALLOWED_EMAIL_DOMAIN=altegra.com

# Public app URL (used to build share links)
APP_URL=http://localhost:3000

# Daily-rotating salt seed used to hash IPs on public submissions.
# Combined with the current UTC date so the effective salt rotates daily.
IP_HASH_SALT=

# Secret used to sign the time-trap cookie on the public form
TIMETRAP_SECRET=
